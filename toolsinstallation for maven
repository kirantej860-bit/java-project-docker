Nexus Install:


wget https://download.sonatype.com/nexus/3/nexus-3.92.2-01-linux-x86_64.tar.gz
tar -zxvf nexus-3.92.2-01-linux-x86_64.tar.gz
useradd nexus
 chown nexus:nexus nexus-3.92.2-01 sonatype-work/ -R
su - nexus
cd /opt
cd nexus-3.92.2-01/bin/
./nexus start
